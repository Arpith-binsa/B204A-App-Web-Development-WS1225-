# .env.example
#
# Copy this file to ".env" and fill in real values. NEVER commit the real .env
# (it is listed in .gitignore) and NEVER paste real secrets into your report.
# On Render.com, set these in the dashboard under the "Environment" tab instead.

# MongoDB (Mongo Database) connection string.
MONGO_URI=your_mongodb_connection_string_here

# Secret used to sign JWTs (JSON Web Tokens). Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_here

# Port the server listens on.
PORT=3000

# PayPal Sandbox client-id. This value is PUBLIC (it is sent to the browser),
# but keeping it here means there is a single source of truth instead of the
# key being hard-coded across many HTML files. The PayPal SECRET is NOT needed
# for this client-side integration and must never be placed in any client file.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CURRENCY=EUR

# Comma-separated list of browser origins allowed to call the API via CORS
# (Cross-Origin Resource Sharing). Leave empty for same-origin-only (the
# default for this app, since the server also serves the frontend).
# Example: CORS_ORIGINS=https://arpith-binsa.onrender.com
CORS_ORIGINS=
